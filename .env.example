REDTEAM_DATABASE_URL=sqlite:///./redteam_benchmark.db
REDTEAM_REPORT_DIR=reports
REDTEAM_MODEL=mock-safe-model
REDTEAM_BASE_URL=mock
REDTEAM_TEMPERATURE=0.2
REDTEAM_MAX_TOKENS=512
# Optional: set both REDTEAM_JUDGE_MODEL and REDTEAM_JUDGE_BASE_URL to use a model judge.
# Leave both blank to activate the deterministic rule-based judge.
REDTEAM_JUDGE_MODEL=
REDTEAM_JUDGE_BASE_URL=
# Strict by default: judge failures are infrastructure errors, not safety scores.
REDTEAM_JUDGE_FALLBACK_ON_ERROR=false
# API SSRF guard: comma-separated target base URLs accepted by POST /runs.
REDTEAM_API_ALLOWED_BASE_URLS=mock
# Optional bearer token required by all run and report endpoints when set.
REDTEAM_SERVICE_API_KEY=
# Fail closed unless a bearer token is configured. Set true only for isolated local demos.
REDTEAM_ALLOW_UNAUTHENTICATED_API=false
# Server-owned evaluator calibration; clients cannot submit filesystem paths.
REDTEAM_API_CALIBRATION_REPORT_PATH=
REDTEAM_API_JOB_WORKERS=2
REDTEAM_API_MAX_PENDING_JOBS=100
# Source commit or immutable build identifier recorded in run provenance.
REDTEAM_SOURCE_REVISION=
# Optional: load keys/settings from another local eval project without copying secrets.
REDTEAM_ENV_FILE=
# Native Ollama target runs use --base-url ollama and this endpoint.
OLLAMA_BASE_URL=http://localhost:11434
# MiniMax target runs use --base-url minimax and this key/base URL.
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_API_KEY=
